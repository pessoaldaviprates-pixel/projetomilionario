# ─── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://nexora:nexora@localhost:5432/nexora_dev?schema=public"

# ─── Aplicação ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
APP_NAME="Nexora"

# Chave usada para assinar tokens (e-mail, convites, reset de senha).
# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-este-valor-por-uma-chave-aleatoria-de-32-bytes-ou-mais"
SESSION_TTL_DAYS="30"

# ─── Armazenamento de arquivos ────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/uploads"
STORAGE_MAX_FILE_MB="25"
# S3 / R2 (quando STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── E-mail ───────────────────────────────────────────────────────────────────
# console | smtp
MAIL_DRIVER="console"
MAIL_FROM="Nexora <nao-responda@nexora.app>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ─── Inteligência artificial ──────────────────────────────────────────────────
# heuristic | anthropic  (heuristic funciona 100% offline, sem chave)
AI_PROVIDER="heuristic"
AI_MODEL="claude-sonnet-5"
ANTHROPIC_API_KEY=""

# ─── Billing ──────────────────────────────────────────────────────────────────
# manual | stripe
BILLING_PROVIDER="manual"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Segurança ────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED="true"
