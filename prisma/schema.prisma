// ─────────────────────────────────────────────────────────────────────────────
// NEXORA — Modelo de dados
//
// Princípios:
//  1. Multi-tenant por coluna: TODA entidade de negócio carrega `companyId`.
//     Nenhuma query de negócio é feita sem esse filtro (ver src/lib/db/tenant.ts).
//  2. Integridade referencial explícita com onDelete definido em cada relação.
//  3. Índices compostos sempre começando por `companyId` — o filtro de tenant é
//     o predicado mais seletivo de toda query do sistema.
//  4. Enums no banco para estados finitos (status, prioridade, papéis).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════════════════════════════════════════════
// IDENTIDADE E TENANTS
// ══════════════════════════════════════════════════════════════════════════════

/// Identidade global da pessoa. Um usuário pode pertencer a várias empresas.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String
  avatarUrl       String?
  phone           String?
  locale          String    @default("pt-BR")
  timezone        String    @default("America/Sao_Paulo")

  /// Administrador da plataforma (Nexora), não de uma empresa.
  isPlatformAdmin Boolean @default(false)

  /// 2FA — infraestrutura pronta; ativação é opcional por usuário.
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  twoFactorBackup  String[] @default([])

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  memberships        Membership[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  ownedCompanies     Company[]           @relation("CompanyOwner")

  @@index([email])
  @@map("users")
}

/// Tenant. Raiz de isolamento de todos os dados de negócio.
model Company {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  logoUrl  String?
  segment  String?
  sizeBand CompanySize?
  goal     String?
  website  String?
  taxId    String?

  /// Preferências do tenant (tema, semana útil, horários, flags de módulo).
  settings Json @default("{}")

  status      CompanyStatus @default(ACTIVE)
  onboardedAt DateTime?

  ownerId String
  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships   Membership[]
  roles         Role[]
  departments   Department[]
  groups        Group[]
  channels      Channel[]
  messages      Message[]
  projects      Project[]
  tasks         Task[]
  meetings      Meeting[]
  events        CalendarEvent[]
  timeBlocks    TimeBlock[]
  folders       Folder[]
  files         FileObject[]
  notifications Notification[]
  announcements Announcement[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  payments      Payment[]
  aiThreads     AiThread[]
  aiActions     AiAction[]
  integrations  Integration[]

  @@index([slug])
  @@index([status])
  @@map("companies")
}

enum CompanySize {
  SOLO // 1
  MICRO // 2-10
  SMALL // 11-50
  MEDIUM // 51-200
  LARGE // 201-1000
  ENTERPRISE // 1000+
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

/// Vínculo usuário ↔ empresa. É AQUI que mora o cargo e o estado do funcionário.
model Membership {
  id        String @id @default(cuid())
  userId    String
  companyId String
  roleId    String

  /// Administrador do tenant: ignora checagem granular de permissões.
  isOwner Boolean @default(false)

  jobTitle     String?
  departmentId String?
  managerId    String?

  status      MembershipStatus @default(ACTIVE)
  presence    Presence         @default(OFFLINE)
  lastSeenAt  DateTime?
  invitedAt   DateTime?
  joinedAt    DateTime         @default(now())
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager    Membership? @relation("OrgChart", fields: [managerId], references: [id], onDelete: SetNull)
  reports    Membership[] @relation("OrgChart")

  channelMemberships ChannelMember[]
  groupMemberships   GroupMember[]
  projectMemberships ProjectMember[]
  messages           Message[]
  reactions          MessageReaction[]
  messageReads       MessageRead[]
  authoredTasks      Task[]            @relation("TaskCreator")
  assignedTasks      Task[]            @relation("TaskAssignee")
  taskComments       TaskComment[]
  taskWatchers       TaskWatcher[]
  ledProjects        Project[]         @relation("ProjectLead")
  organizedMeetings  Meeting[]         @relation("MeetingOrganizer")
  meetingSeats       MeetingParticipant[]
  events             CalendarEvent[]   @relation("EventOwner")
  eventSeats         EventAttendee[]
  timeBlocks         TimeBlock[]
  uploads            FileObject[]      @relation("FileOwner")
  notifications      Notification[]
  announcements      Announcement[]    @relation("AnnouncementAuthor")
  announcementReads  AnnouncementRead[]
  managedDepartments Department[]      @relation("DepartmentLead")
  auditLogs          AuditLog[]
  aiThreads          AiThread[]
  aiActions          AiAction[]

  @@unique([userId, companyId])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@index([companyId, roleId])
  @@index([userId])
  @@map("memberships")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Presence {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

// ══════════════════════════════════════════════════════════════════════════════
// CARGOS E PERMISSÕES
// ══════════════════════════════════════════════════════════════════════════════

/// Cargo dentro de uma empresa. Cargos padrão são semeados na criação do tenant,
/// mas o administrador pode criar/editar/remover livremente.
model Role {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  slug        String
  description String?
  color       String  @default("#2E7DFF")
  icon        String?

  /// Lista de chaves de permissão (ver src/lib/authz/permissions.ts).
  permissions String[] @default([])

  /// Cargo semeado pelo sistema: não pode ser excluído, apenas editado.
  isSystem Boolean @default(false)
  /// Cargo atribuído a novos membros quando nenhum for informado.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  /// Hierarquia visual/organograma (menor = mais alto).
  rank Int @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([companyId, slug])
  @@index([companyId, isActive])
  @@map("roles")
}

// ══════════════════════════════════════════════════════════════════════════════
// ESTRUTURA ORGANIZACIONAL
// ══════════════════════════════════════════════════════════════════════════════

model Department {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  slug        String
  description String?
  color       String  @default("#2E7DFF")
  parentId    String?
  leadId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")
  lead     Membership?  @relation("DepartmentLead", fields: [leadId], references: [id], onDelete: SetNull)
  members  Membership[]
  groups   Group[]

  @@unique([companyId, slug])
  @@index([companyId, parentId])
  @@map("departments")
}

/// Equipe/grupo transversal (pode cruzar departamentos).
model Group {
  id           String  @id @default(cuid())
  companyId    String
  departmentId String?
  name         String
  slug         String
  description  String?
  color        String  @default("#2E7DFF")
  isPrivate    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members    GroupMember[]
  channels   Channel[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("groups")
}

model GroupMember {
  id           String   @id @default(cuid())
  groupId      String
  membershipId String
  isLead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([groupId, membershipId])
  @@index([membershipId])
  @@map("group_members")
}

// ══════════════════════════════════════════════════════════════════════════════
// COMUNICAÇÃO
// ══════════════════════════════════════════════════════════════════════════════

model Channel {
  id          String      @id @default(cuid())
  companyId   String
  groupId     String?
  projectId   String?
  name        String
  slug        String
  topic       String?
  description String?
  kind        ChannelKind @default(PUBLIC)

  isArchived    Boolean   @default(false)
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group    Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  members  ChannelMember[]
  messages Message[]

  @@unique([companyId, slug])
  @@index([companyId, kind, isArchived])
  @@index([companyId, lastMessageAt])
  @@map("channels")
}

enum ChannelKind {
  PUBLIC // qualquer membro da empresa pode entrar
  PRIVATE // apenas convidados
  DIRECT // conversa 1:1
  GROUP_DM // conversa entre 3+ pessoas
}

model ChannelMember {
  id            String    @id @default(cuid())
  channelId     String
  membershipId  String
  isAdmin       Boolean   @default(false)
  isMuted       Boolean   @default(false)
  isPinned      Boolean   @default(false)
  lastReadAt    DateTime?
  lastReadMessageId String?
  joinedAt      DateTime  @default(now())

  channel    Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([channelId, membershipId])
  @@index([membershipId])
  @@map("channel_members")
}

model Message {
  id        String @id @default(cuid())
  companyId String
  channelId String
  authorId  String

  body        String
  /// Blocos ricos/menções estruturadas. Texto puro fica em `body`.
  richContent Json?
  kind        MessageKind @default(TEXT)

  /// Thread: mensagem raiz da conversa encadeada.
  parentId   String?
  replyCount Int     @default(0)

  isPinned  Boolean   @default(false)
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  deletedAt DateTime?

  /// IDs de membership mencionados (mantido desnormalizado para busca rápida).
  mentions String[] @default([])
  /// @everyone / @channel
  mentionsEveryone Boolean @default(false)

  /// Rastreabilidade: item gerado a partir desta mensagem.
  linkedTaskId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel     Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      Membership        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent      Message?          @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Message[]         @relation("MessageThread")
  linkedTask  Task?             @relation("TaskFromMessage", fields: [linkedTaskId], references: [id], onDelete: SetNull)
  reactions   MessageReaction[]
  attachments FileObject[]      @relation("MessageAttachment")
  reads       MessageRead[]

  @@index([companyId, channelId, createdAt])
  @@index([channelId, parentId, createdAt])
  @@index([companyId, authorId])
  @@map("messages")
}

enum MessageKind {
  TEXT
  FILE
  SYSTEM
  AI_SUGGESTION
  MEETING_SUMMARY
}

model MessageReaction {
  id           String   @id @default(cuid())
  messageId    String
  membershipId String
  emoji        String
  createdAt    DateTime @default(now())

  message    Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([messageId, membershipId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

/// Marcação explícita para "favoritar"/salvar e leitura por mensagem.
model MessageRead {
  id           String   @id @default(cuid())
  messageId    String
  membershipId String
  isSaved      Boolean  @default(false)
  readAt       DateTime @default(now())

  message    Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([messageId, membershipId])
  @@index([membershipId, isSaved])
  @@map("message_reads")
}

// ══════════════════════════════════════════════════════════════════════════════
// PROJETOS E TAREFAS
// ══════════════════════════════════════════════════════════════════════════════

model Project {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  key         String // prefixo curto: NEX, MKT…
  description String?
  color       String  @default("#2E7DFF")

  status   ProjectStatus @default(ACTIVE)
  leadId   String?
  startsAt DateTime?
  dueAt    DateTime?
  /// 0–100. Recalculado a partir das tarefas concluídas.
  progress Int @default(0)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead     Membership?     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  members  ProjectMember[]
  tasks    Task[]
  meetings Meeting[]
  files    FileObject[]
  channels Channel[]
  events   CalendarEvent[]

  @@unique([companyId, key])
  @@index([companyId, status])
  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELED
}

model ProjectMember {
  id           String   @id @default(cuid())
  projectId    String
  membershipId String
  isLead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([projectId, membershipId])
  @@index([membershipId])
  @@map("project_members")
}

model Task {
  id        String  @id @default(cuid())
  companyId String
  projectId String?

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  creatorId  String
  assigneeId String?

  startsAt    DateTime?
  dueAt       DateTime?
  completedAt DateTime?
  /// Estimativa e realizado, em minutos.
  estimateMinutes Int?
  spentMinutes    Int  @default(0)

  /// Subtarefas: auto-relação.
  parentId String?
  /// Ordenação dentro da coluna do kanban.
  position Int @default(0)

  tags String[] @default([])

  /// Proveniência: como esta tarefa nasceu (chat, reunião, IA, manual).
  origin       TaskOrigin @default(MANUAL)
  originRefId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator      Membership       @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee     Membership?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent       Task?            @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]           @relation("Subtasks")
  comments     TaskComment[]
  watchers     TaskWatcher[]
  checklist    ChecklistItem[]
  files        FileObject[]
  activities   TaskActivity[]
  timeBlocks   TimeBlock[]
  events       CalendarEvent[]
  sourceMessages Message[]      @relation("TaskFromMessage")
  blockedBy    TaskDependency[] @relation("DependencyBlocked")
  blocks       TaskDependency[] @relation("DependencyBlocker")
  meetingItems MeetingActionItem[]

  @@index([companyId, status, dueAt])
  @@index([companyId, assigneeId, status])
  @@index([companyId, projectId, status, position])
  @@index([companyId, parentId])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskOrigin {
  MANUAL
  MESSAGE
  MEETING
  AI
  AUTOMATION
  IMPORT
}

model TaskDependency {
  id        String @id @default(cuid())
  /// A tarefa que fica bloqueada.
  blockedId String
  /// A tarefa que precisa terminar antes.
  blockerId String

  blocked Task @relation("DependencyBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker Task @relation("DependencyBlocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockedId, blockerId])
  @@map("task_dependencies")
}

model ChecklistItem {
  id       String  @id @default(cuid())
  taskId   String
  title    String
  isDone   Boolean @default(false)
  position Int     @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@map("checklist_items")
}

model TaskComment {
  id       String @id @default(cuid())
  taskId   String
  authorId String
  body     String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Membership @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskWatcher {
  id           String @id @default(cuid())
  taskId       String
  membershipId String

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([taskId, membershipId])
  @@map("task_watchers")
}

/// Histórico de mudanças de uma tarefa (quem mudou o quê e quando).
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String?
  action    String
  field     String?
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_activities")
}

// ══════════════════════════════════════════════════════════════════════════════
// REUNIÕES
// ══════════════════════════════════════════════════════════════════════════════

model Meeting {
  id          String  @id @default(cuid())
  companyId   String
  projectId   String?
  title       String
  description String?
  agenda      String?

  organizerId String
  startsAt    DateTime
  endsAt      DateTime
  timezone    String        @default("America/Sao_Paulo")
  location    String?
  /// URL da sala (interna ou provedor externo).
  roomUrl     String?
  provider    MeetingProvider @default(NEXORA)
  status      MeetingStatus   @default(SCHEDULED)

  /// Regra de recorrência (RFC 5545 simplificada) e vínculo com a série.
  recurrenceRule String?
  seriesId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  organizer    Membership           @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  participants MeetingParticipant[]
  notes        MeetingNote[]
  actionItems  MeetingActionItem[]
  recordings   MeetingRecording[]
  events       CalendarEvent[]
  files        FileObject[]

  @@index([companyId, startsAt])
  @@index([companyId, status, startsAt])
  @@index([seriesId])
  @@map("meetings")
}

enum MeetingProvider {
  NEXORA
  GOOGLE_MEET
  ZOOM
  TEAMS
  EXTERNAL
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELED
}

model MeetingParticipant {
  id           String            @id @default(cuid())
  meetingId    String
  membershipId String
  isRequired   Boolean           @default(true)
  response     AttendeeResponse  @default(PENDING)
  joinedAt     DateTime?
  leftAt       DateTime?

  meeting    Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([meetingId, membershipId])
  @@index([membershipId])
  @@map("meeting_participants")
}

enum AttendeeResponse {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

/// Transcrição, resumo e ata — produzidos pelo módulo de IA.
model MeetingNote {
  id        String          @id @default(cuid())
  meetingId String
  kind      MeetingNoteKind
  content   String
  /// Decisões/estruturas extraídas pela IA.
  structured Json?
  /// Provedor/modelo que gerou (auditoria de IA).
  generatedBy String?
  createdAt   DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, kind])
  @@map("meeting_notes")
}

enum MeetingNoteKind {
  TRANSCRIPT
  SUMMARY
  DECISIONS
  MINUTES
  MANUAL
}

/// Item de ação identificado na reunião — vira tarefa ao ser aceito.
model MeetingActionItem {
  id         String  @id @default(cuid())
  meetingId  String
  title      String
  assigneeHint String?
  dueHint      String?
  dueAt        DateTime?
  /// Confiança da extração (0–1) quando gerado por IA.
  confidence Float?
  status     ActionItemStatus @default(SUGGESTED)
  taskId     String?

  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([meetingId, status])
  @@map("meeting_action_items")
}

enum ActionItemStatus {
  SUGGESTED
  ACCEPTED
  DISMISSED
}

model MeetingRecording {
  id          String   @id @default(cuid())
  meetingId   String
  fileId      String?
  url         String?
  durationSec Int?
  createdAt   DateTime @default(now())

  meeting Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  file    FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@map("meeting_recordings")
}

// ══════════════════════════════════════════════════════════════════════════════
// AGENDA E TIME BLOCKING
// ══════════════════════════════════════════════════════════════════════════════

model CalendarEvent {
  id        String @id @default(cuid())
  companyId String
  ownerId   String

  title       String
  description String?
  kind        EventKind @default(EVENT)
  color       String?

  startsAt DateTime
  endsAt   DateTime
  allDay   Boolean  @default(false)
  location String?

  /// Origem do evento — mantém agenda e módulos sincronizados.
  meetingId String?
  taskId    String?
  projectId String?

  /// Sincronização com calendário externo (arquitetura de integração).
  externalProvider String?
  externalId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner     Membership      @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  meeting   Meeting?        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  task      Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  attendees EventAttendee[]

  @@index([companyId, startsAt])
  @@index([companyId, ownerId, startsAt])
  @@unique([externalProvider, externalId])
  @@map("calendar_events")
}

enum EventKind {
  EVENT
  MEETING
  TASK
  DEADLINE
  REMINDER
  FOCUS
  OUT_OF_OFFICE
}

model EventAttendee {
  id           String           @id @default(cuid())
  eventId      String
  membershipId String
  response     AttendeeResponse @default(PENDING)

  event      CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  membership Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([eventId, membershipId])
  @@map("event_attendees")
}

/// Bloco de foco: tarefa arrastada para um horário do calendário.
model TimeBlock {
  id           String @id @default(cuid())
  companyId    String
  membershipId String
  taskId       String?

  title    String
  startsAt DateTime
  endsAt   DateTime
  isDone   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  task       Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([companyId, membershipId, startsAt])
  @@map("time_blocks")
}

// ══════════════════════════════════════════════════════════════════════════════
// ARQUIVOS
// ══════════════════════════════════════════════════════════════════════════════

model Folder {
  id        String  @id @default(cuid())
  companyId String
  name      String
  parentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Folder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[]     @relation("FolderTree")
  files    FileObject[]

  @@index([companyId, parentId])
  @@map("folders")
}

model FileObject {
  id        String  @id @default(cuid())
  companyId String
  folderId  String?
  ownerId   String

  name         String
  /// Caminho/chave no driver de storage. NUNCA é exposto direto ao cliente.
  storageKey   String
  mimeType     String
  sizeBytes    Int
  category     FileCategory @default(OTHER)
  checksum     String?
  /// Visibilidade padrão dentro do tenant.
  visibility   FileVisibility @default(COMPANY)

  /// Vínculos que mantêm o arquivo visível no contexto certo.
  projectId String?
  taskId    String?
  meetingId String?
  messageId String?

  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  folder     Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  owner      Membership         @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  project    Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task       Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  meeting    Meeting?           @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  message    Message?           @relation("MessageAttachment", fields: [messageId], references: [id], onDelete: Cascade)
  recordings MeetingRecording[]

  @@index([companyId, deletedAt, createdAt])
  @@index([companyId, category])
  @@index([companyId, projectId])
  @@map("files")
}

enum FileCategory {
  DOCUMENT
  IMAGE
  VIDEO
  AUDIO
  PDF
  SPREADSHEET
  PRESENTATION
  ARCHIVE
  OTHER
}

enum FileVisibility {
  PRIVATE
  COMPANY
  PROJECT
  CHANNEL
}

// ══════════════════════════════════════════════════════════════════════════════
// NOTIFICAÇÕES E AVISOS
// ══════════════════════════════════════════════════════════════════════════════

model Notification {
  id           String @id @default(cuid())
  companyId    String
  membershipId String

  kind    NotificationKind
  title   String
  body    String?
  /// Link interno para a entidade de origem.
  href    String?
  /// Tipo + id da entidade que gerou a notificação.
  entityType String?
  entityId   String?
  actorId    String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([companyId, membershipId, readAt, createdAt])
  @@map("notifications")
}

enum NotificationKind {
  MESSAGE
  MENTION
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_DUE
  MEETING_INVITE
  MEETING_REMINDER
  COMMENT
  FILE_SHARED
  PROJECT_UPDATED
  ANNOUNCEMENT
  SYSTEM
  BILLING
}

model Announcement {
  id        String @id @default(cuid())
  companyId String
  authorId  String

  title    String
  body     String
  severity AnnouncementSeverity @default(INFO)

  /// Público-alvo: empresa inteira, departamento, grupo ou cargo.
  audience       AnnouncementAudience @default(COMPANY)
  departmentId   String?
  groupId        String?
  roleId         String?

  publishedAt DateTime?
  expiresAt   DateTime?
  pinned      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  Membership         @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reads   AnnouncementRead[]

  @@index([companyId, publishedAt])
  @@map("announcements")
}

enum AnnouncementSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum AnnouncementAudience {
  COMPANY
  DEPARTMENT
  GROUP
  ROLE
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  membershipId   String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([announcementId, membershipId])
  @@map("announcement_reads")
}

// ══════════════════════════════════════════════════════════════════════════════
// BILLING
// ══════════════════════════════════════════════════════════════════════════════

/// Catálogo de planos. Editável pelo Platform Admin — preços NÃO são fixos no código.
model Plan {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String?
  /// Preço em centavos, para evitar erro de ponto flutuante.
  priceCents  Int
  currency    String  @default("BRL")
  interval    BillingInterval @default(MONTHLY)

  maxUsers      Int?
  storageGb     Int
  features      String[] @default([])
  /// Chaves de recurso habilitadas (ver src/lib/billing/entitlements.ts).
  entitlements  String[] @default([])

  isActive    Boolean @default(true)
  isPopular   Boolean @default(false)
  position    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Subscription {
  id        String @id @default(cuid())
  companyId String @unique
  planId    String

  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?

  /// Referências do gateway — nenhum dado sensível de cartão é persistido.
  provider           String  @default("manual")
  providerCustomerId String?
  providerSubId      String?

  seats Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Payment {
  id             String @id @default(cuid())
  companyId      String
  subscriptionId String?

  amountCents Int
  currency    String        @default("BRL")
  status      PaymentStatus @default(PENDING)
  method      PaymentMethod

  /// Somente referências e metadados não sensíveis (bandeira, 4 últimos dígitos).
  providerPaymentId String?
  cardBrand         String?
  cardLast4         String?
  pixQrCode         String?
  boletoUrl         String?
  invoiceUrl        String?
  failureReason     String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  PIX
  BOLETO
  MANUAL
}

/// Log idempotente de webhooks do gateway.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// ══════════════════════════════════════════════════════════════════════════════
// IA
// ══════════════════════════════════════════════════════════════════════════════

model AiThread {
  id           String @id @default(cuid())
  companyId    String
  membershipId String
  title        String @default("Nova conversa")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  messages   AiMessage[]

  @@index([companyId, membershipId, updatedAt])
  @@map("ai_threads")
}

model AiMessage {
  id       String    @id @default(cuid())
  threadId String
  role     AiRole
  content  String
  /// Ferramentas/consultas executadas e citações das fontes usadas.
  metadata Json?
  tokensIn  Int?
  tokensOut Int?
  createdAt DateTime @default(now())

  thread AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("ai_messages")
}

enum AiRole {
  USER
  ASSISTANT
  SYSTEM
}

/// Ação sugerida pela IA aguardando confirmação humana.
/// A IA NUNCA escreve direto: ela propõe, a pessoa aprova.
model AiAction {
  id           String @id @default(cuid())
  companyId    String
  membershipId String

  kind       AiActionKind
  status     AiActionStatus @default(SUGGESTED)
  /// Payload validado por zod antes da execução.
  payload    Json
  rationale  String?
  confidence Float?

  sourceType String?
  sourceId   String?
  resultType String?
  resultId   String?

  decidedAt DateTime?
  createdAt DateTime  @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([companyId, membershipId, status])
  @@map("ai_actions")
}

enum AiActionKind {
  CREATE_TASK
  CREATE_MEETING
  CREATE_EVENT
  CREATE_REMINDER
  CREATE_PROJECT
  ASSIGN_TASK
  SET_DUE_DATE
  SUMMARIZE
}

enum AiActionStatus {
  SUGGESTED
  ACCEPTED
  DISMISSED
  FAILED
}

// ══════════════════════════════════════════════════════════════════════════════
// SESSÕES, CONVITES, AUDITORIA, INTEGRAÇÕES
// ══════════════════════════════════════════════════════════════════════════════

/// Sessão opaca. Guardamos apenas o HASH do token — vazamento do banco não
/// permite sequestro de sessão.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  /// Empresa ativa da sessão (troca de tenant sem novo login).
  companyId String?

  ipAddress String?
  userAgent String?

  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  revokedAt      DateTime?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Token de uso único: verificação de e-mail, reset de senha, 2FA.
model VerificationToken {
  id        String            @id @default(cuid())
  userId    String?
  email     String
  tokenHash String            @unique
  purpose   VerificationPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@map("verification_tokens")
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

model Invitation {
  id        String @id @default(cuid())
  companyId String
  email     String
  roleId    String?
  departmentId String?
  invitedById  String?

  tokenHash String    @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId, status])
  @@map("invitations")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Trilha de auditoria imutável (append-only).
model AuditLog {
  id        String  @id @default(cuid())
  companyId String?
  actorId   String?
  actorEmail String?

  action     String
  entityType String?
  entityId   String?
  /// Diff resumido: { campo: [antes, depois] }
  changes    Json?
  metadata   Json?

  ipAddress String?
  userAgent String?
  severity  AuditSeverity @default(INFO)

  createdAt DateTime @default(now())

  company Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   Membership? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, action])
  @@index([actorId])
  @@map("audit_logs")
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Conexão com serviço externo. Credenciais sempre criptografadas em repouso.
model Integration {
  id        String @id @default(cuid())
  companyId String
  provider  String
  status    IntegrationStatus @default(DISCONNECTED)
  config    Json   @default("{}")
  /// Cifrado com AUTH_SECRET (AES-256-GCM) — nunca em texto puro.
  credentials String?
  connectedById String?
  lastSyncAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@map("integrations")
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}
